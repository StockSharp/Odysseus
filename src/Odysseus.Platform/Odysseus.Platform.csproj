<Project Sdk="Microsoft.NET.Sdk">

	<ItemGroup>
		<!-- The trading platform, built from the checkout Directory.Build.props points at. -->
		<ProjectReference Include="$(StockSharpSource)\Algo.Strategies\Algo.Strategies.csproj" />
		<ProjectReference Include="$(StockSharpSource)\Algo.Indicators\Algo.Indicators.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!--
		Loading a compiled candidate is visible to the two projects that are allowed to do it and to
		nothing else, so that no host can load one by accident. That is a compile-time guarantee, which
		is stronger than a test.
		-->
		<InternalsVisibleTo Include="Odysseus.Broker" />
		<InternalsVisibleTo Include="Odysseus.Worker" />
		<InternalsVisibleTo Include="Odysseus.Broker.Tests" />
		<InternalsVisibleTo Include="Odysseus.Worker.Tests" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Odysseus.Application\Odysseus.Application.csproj" />
		<ProjectReference Include="..\Odysseus.Domain\Odysseus.Domain.csproj" />
	</ItemGroup>

	<!--
	A checkout that is not there is otherwise reported as a warning, above an error for every type of
	the platform the compiler could not find.
	-->
	<Target Name="RequireStockSharpSource" BeforeTargets="BeforeBuild" Condition="!Exists('$(StockSharpSource)\Algo.Strategies\Algo.Strategies.csproj')">
		<Error Text="The trading platform is built from source, and there is no StockSharp repository at '$(StockSharpSource)'. Clone https://github.com/StockSharp/StockSharp.git into that folder, or name another checkout as StockSharpSource in Directory.Build.local.props." />
	</Target>

</Project>
