<Project>

	<!-- Machine-specific settings that are never committed, such as a StockSharpSource of its own. -->
	<Import Project="Directory.Build.local.props" Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.local.props')" />

	<PropertyGroup>
		<!--
		The trading platform is built from source. Its repository is looked for beside this one, in the
		folder the other StockSharp repositories look for it in as well.
		-->
		<StockSharpSource Condition="'$(StockSharpSource)' == ''">$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', 'StockSharp (GitHub)'))</StockSharpSource>
	</PropertyGroup>

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>StockSharp.$(MSBuildProjectName)</RootNamespace>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>disable</ImplicitUsings>
		<!-- Nullable reference types are deliberately off: `?` is used for value types only. -->
		<Nullable>disable</Nullable>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<AnalysisLevel>latest</AnalysisLevel>
		<Deterministic>true</Deterministic>
		<ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<Company>Odysseus</Company>
		<Product>Odysseus</Product>
		<!--
		A release says which version it is under a name of its own. Version given on the command line
		would reach the StockSharp projects as well, and a broker connector compiled against their
		assembly version would no longer find them.
		-->
		<Version Condition="'$(OdysseusVersion)' != ''">$(OdysseusVersion)</Version>
	</PropertyGroup>

	<PropertyGroup Condition="'$(MSBuildProjectName)' == 'Odysseus.Server' Or '$(MSBuildProjectName)' == 'Odysseus.Cli'">
		<PackAsTool>true</PackAsTool>
		<Authors>StockSharp</Authors>
		<Description>Local quantitative research with StockSharp, including the worker and deployment runner.</Description>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageProjectUrl>https://github.com/StockSharp/Odysseus</PackageProjectUrl>
		<RepositoryUrl>https://github.com/StockSharp/Odysseus</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>stocksharp;mcp;quantitative-research;backtesting;trading</PackageTags>
	</PropertyGroup>

	<ItemGroup Condition="'$(PackAsTool)' == 'true'">
		<None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="/" />
		<None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" />
	</ItemGroup>

</Project>
