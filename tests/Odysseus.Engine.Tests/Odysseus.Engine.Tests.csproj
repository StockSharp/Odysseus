		<ProjectReference Include="..\..\src\Odysseus.Engine\Odysseus.Engine.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!--
		Referenced so that building these tests builds the misbehaving worker they point the host at,
		never so that they link it: a worker is reached by path, which is the whole point of it.
		-->
