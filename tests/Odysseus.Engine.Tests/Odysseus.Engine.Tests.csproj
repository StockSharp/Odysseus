		<!-- The same for the runner: a process that outlives its parent is reached by path, never linked. -->
		<ProjectReference Include="..\Odysseus.RunnerStub\Odysseus.RunnerStub.csproj" ReferenceOutputAssembly="false" />
	</ItemGroup>

</Project>
