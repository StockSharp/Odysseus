	</ItemGroup>

	<ItemGroup>
		<Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Odysseus.TestKit\Odysseus.TestKit.csproj" />
		<ProjectReference Include="..\..\src\Odysseus.Domain\Odysseus.Domain.csproj" />
